{
  "name": "qnet-node",
  "version": "2.0.0",
  "description": "Node.js implementation of QNet: UDP networking with reliable, sequenced and unreliable channels, wire-compatible with QNet for GameMaker.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "qnet-generate": "dist/codegen/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --runInBand",
    "lint": "eslint src tests examples --ext .ts",
    "typecheck": "tsc --noEmit",
    "generate": "ts-node src/codegen/cli.ts",
    "demo:host": "ts-node examples/demo-host.ts",
    "demo:client": "ts-node examples/demo-client.ts"
  },
  "keywords": [
    "gamemaker",
    "networking",
    "udp",
    "multiplayer"
  ],
  "author": "Logan Spencer",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.4"
  }
}
